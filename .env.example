DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Set for immediate development-server command registration; omit for global commands.
DISCORD_GUILD_ID=
BOT_CONFIG_PATH=config/bot.json
LOG_LEVEL=info
# WHISPER_CLI_PATH=vendor/whisper.cpp/build/bin/whisper-cli
# FFMPEG_PATH=/usr/bin/ffmpeg

# SETUP: put real values in .env, never in this tracked example file.
# Optional meeting reports. Fill only the selected provider's API key.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Private Google Docs URLs (never put actual links in config/bot.json).
REPORT_TEMPLATE_URL=
REPORT_LOG_URL=
# Private report configuration. The Discord server ID and project label stay out of
# the tracked config/bot.json as well.
REPORTS_ENABLED=false
REPORTS_PROVIDER=gemini
REPORTS_MODEL=gemini-3.1-flash-lite
REPORTS_GUILD_ID=
REPORTS_PROJECT=Not specified
# Optional: automatic (default) or review; IDs are comma-separated.
# REPORTS_PUBLICATION_MODE=automatic
# REPORTS_ALLOWED_ROLE_IDS=
# REPORTS_TIMEZONE=America/Los_Angeles
# REPORTS_TEMPLATE_TAB_ID=
# REPORTS_LOG_TAB_ID=
# Google credentials are separate from the AI provider key. In your private .env,
# fill the variable below with the complete downloaded JSON in single quotes.
# Preserve JSON's escaped \n in the key. Quoted multiline JSON also works.
GOOGLE_CREDENTIALS_JSON=
# Format example only (replace the blank assignment above in .env):
# GOOGLE_CREDENTIALS_JSON='{"type":"service_account","client_email":"BOT@PROJECT.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"}'
# Alternatively, use a credential file. GOOGLE_CREDENTIALS_JSON takes precedence.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-credentials.json
