{
  "name": "discord-audio-transcriber",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local per-speaker Discord voice transcription with whisper.cpp",
  "license": "MIT",
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "register": "tsx scripts/register-commands.ts",
    "setup:whisper": "tsx scripts/setup-whisper.ts",
    "smoke:whisper": "tsx scripts/smoke-whisper.ts",
    "model:download": "tsx scripts/download-model.ts",
    "doctor": "tsx scripts/doctor.ts",
    "doctor:reports": "tsx scripts/doctor-reports.ts",
    "retry-delivery": "tsx scripts/retry-delivery.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run format:check"
  },
  "dependencies": {
    "@discordjs/opus": "0.10.0",
    "@discordjs/voice": "0.19.2",
    "@google/genai": "2.30.0",
    "discord.js": "14.27.0",
    "dotenv": "^17.2.3",
    "ffmpeg-static": "5.3.0",
    "google-auth-library": "11.3.1",
    "openai": "7.39.0",
    "pino": "^10.1.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@discordjs/node-pre-gyp": {
      "tar": "7.5.22"
    }
  }
}
